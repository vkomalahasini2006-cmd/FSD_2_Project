# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
# Format: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://user:password@cluster0.sg0ecjq.mongodb.net/rentkart?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=rentkart_super_secret_jwt_key_development_2026_xyz
JWT_EXPIRES_IN=7d

# Client Application URL (For CORS and email links)
CLIENT_URL=http://localhost:5173

# Cloudinary (Image Uploads - up to 4 images per listing)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer / SMTP Settings (For 6-digit email OTPs)
# In development, if SMTP is not provided or fails, OTP will also log to terminal console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM="RentKart <no-reply@rentkart.com>"
